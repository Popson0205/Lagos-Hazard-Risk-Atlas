# Supabase (or any PostGIS-enabled Postgres) connection string.
# For Supabase, use the Session pooler string from Project Settings >
# Database > Connect (direct connection is IPv6-only), and rewrite the
# scheme to postgresql+psycopg://, e.g.:
# postgresql+psycopg://postgres.xxxxxxxx:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg://risk_atlas:risk_atlas_dev_password@localhost:5432/risk_atlas

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Earth Search STAC endpoint (AWS Open Data, public, no key/signing needed)
STAC_API_URL=https://earth-search.aws.element84.com/v1

# Default AOI for imagery search if the client doesn't supply one (Lagos State bbox)
DEFAULT_AOI_BBOX=2.7,6.35,4.3,6.7
