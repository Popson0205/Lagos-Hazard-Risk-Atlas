# --- Database (Supabase Postgres+PostGIS, or local docker postgis service) ---
DATABASE_URL=postgresql+psycopg://risk_atlas:risk_atlas@postgis:5432/risk_atlas
# For Supabase, use the Session pooler connection string (Project Settings >
# Database > Connect), not the direct connection — the direct connection is
# IPv6-only unless you've bought the IPv4 add-on. Rewrite the scheme to
# postgresql+psycopg://, e.g.:
# DATABASE_URL=postgresql+psycopg://postgres.xxxxxxxx:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Raster tiling ---
TITILER_BASE_URL=http://titiler:8000

# --- Object storage for generated/cached COGs (optional; local disk works for dev) ---
STORAGE_BACKEND=local          # local | s3
STORAGE_LOCAL_PATH=/data/cogs
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Earth Search STAC (AWS Open Data) ---
STAC_API_URL=https://earth-search.aws.element84.com/v1

# --- App ---
ENV=development
CORS_ORIGINS=http://localhost:5173
API_V1_PREFIX=/api/v1
